generator client {
  provider = "prisma-client-js"
}

generator seed {
  provider = "tsx prisma/seed.ts"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  passwordHash          String                 @map("password_hash")
  isAdmin               Boolean                @default(true) @map("is_admin")
  avatarUrl             String?                @map("avatar_url")
  lastLogin             DateTime?              @map("last_login")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  articles              Article[]
  avatars               Avatar[]               @relation("UserAvatars")
  clientCasesUpdated    ClientCase[]           @relation("ClientCaseUpdater")
  clientCasesCreated    ClientCase[]           @relation("ClientCaseCreator")
  contactSubmissions    ContactSubmission[]
  processedApplications JobApplication[]       @relation("ProcessedApplications")
  jobPositions          JobPosition[]          @relation("UserJobPositions")
  missionItems          MissionItem[]
  missionModules        MissionModule[]
  notifications         Notification[]
  partnersUpdated       Partner[]              @relation("PartnerUpdater")
  partnersCreated       Partner[]              @relation("PartnerCreator")
  products              Product[]
  qualificationsUpdated Qualification[]        @relation("QualificationUpdater")
  qualificationsCreated Qualification[]        @relation("QualificationCreator")
  awardsUpdated         Award[]                @relation("AwardUpdater")
  awardsCreated         Award[]                @relation("AwardCreator")
  research              Research[]             @relation("UserResearch")
  services              Service[]
  solutions             Solution[]
  talentPoolAdded       TalentPool[]           @relation("TalentPoolAddedBy")
  talentInteractions    TalentInteraction[]    @relation("TalentInteractionCreatedBy")

  @@map("users")
}

model ContactSubmission {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  subject     String
  message     String
  ipAddress   String?       @map("ip_address")
  userAgent   String?       @map("user_agent")
  status      ContactStatus @default(NEW)
  adminNotes  String?       @map("admin_notes")
  processedBy String?       @map("processed_by")
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  processor   User?         @relation(fields: [processedBy], references: [id])

  @@map("contact_submissions")
}

model JobPosition {
  id           String           @id @default(cuid())
  title        String
  department   String
  location     String
  type         String
  experience   String
  salary       String?
  description  String
  requirements String
  benefits     String
  tags         String
  isHot        Boolean          @default(false) @map("is_hot")
  isUrgent     Boolean          @default(false) @map("is_urgent")
  status       String           @default("published")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdBy    String?          @map("created_by")
  applications JobApplication[]
  creator      User?            @relation("UserJobPositions", fields: [createdBy], references: [id])

  @@map("job_positions")
}

model JobApplication {
  id            String      @id @default(cuid())
  jobId         String      @map("job_id")
  applicantName String      @map("applicant_name")
  email         String
  phone         String?
  introduction  String?
  resumeUrl     String?     @map("resume_url")
  resumeData    Bytes?      @map("resume_data")
  resumeName    String?     @map("resume_name")
  resumeType    String?     @map("resume_type")
  resumeSize    Int?        @map("resume_size")
  status        JobStatus   @default(NEW)
  adminNotes    String?     @map("admin_notes")
  processedBy   String?     @map("processed_by")
  processedAt   DateTime?   @map("processed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  job           JobPosition @relation(fields: [jobId], references: [id])
  processor     User?       @relation("ProcessedApplications", fields: [processedBy], references: [id])
  talentPool    TalentPool? // 关联人才储备库

  @@map("job_applications")
}

// 人才储备库模型
model TalentPool {
  id              String            @id @default(cuid())
  applicationId   String            @unique @map("application_id")

  // 补充信息
  currentPosition String?           @map("current_position")
  currentCompany  String?           @map("current_company")
  expectedSalary  String?           @map("expected_salary")
  availability    AvailabilityStatus @default(AVAILABLE)
  rating          Int?              @default(3) // 1-5星评级
  tags            String?           // JSON格式技能标签
  notes           String?           // HR备注

  // 管理信息
  addedBy         String            @map("added_by")
  addedReason     String?           @map("added_reason")
  lastContactAt   DateTime?         @map("last_contact_at")
  nextFollowUp    DateTime?         @map("next_follow_up")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // 关联关系
  application     JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interactions    TalentInteraction[]
  addedByUser     User              @relation("TalentPoolAddedBy", fields: [addedBy], references: [id])

  @@map("talent_pool")
}

// 人才互动记录模型
model TalentInteraction {
  id          String            @id @default(cuid())
  talentId    String            @map("talent_id")
  type        InteractionType
  content     String
  nextAction  String?           @map("next_action")
  scheduledAt DateTime?         @map("scheduled_at")
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  talent      TalentPool        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  createdByUser User            @relation("TalentInteractionCreatedBy", fields: [createdBy], references: [id])

  @@map("talent_interactions")
}

model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  category    String?
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_configs")
}

model CompanyLocation {
  id            String              @id @default(cuid())
  name          String
  type          CompanyLocationType @default(OFFICE)
  address       String
  phone         String?
  email         String?
  longitude     Float?
  latitude      Float?
  description   String?
  isDefault     Boolean             @default(false)
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  businessHours String?
  contactPerson String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("company_locations")
}



model ProductCategory {
  id          String   @id
  name        String
  description String
  iconName    String   @map("icon_name")
  gradient    String
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("product_categories")
}

model Product {
  id             String        @id @default(cuid())
  category       String
  title          String
  subtitle       String?
  description    String?
  features       Json?
  specifications Json?
  applications   Json?
  benefits       Json?
  image          String?
  images         Json?
  status         ProductStatus @default(AVAILABLE)
  slug           String        @unique
  tags           Json?
  gradient       String?
  accentColor    String?       @map("accent_color")
  updatedBy      String?       @map("updated_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  updater        User?         @relation(fields: [updatedBy], references: [id])

  @@map("products")
}

model Solution {
  id           String   @id @default(cuid())
  category     String
  title        String
  subtitle     String?
  description  String?
  content      String?
  features     Json?
  applications Json?
  metrics      Json?
  technologies Json?
  benefits     Json?
  image        String?
  slug         String   @unique
  gradient     String?
  accentColor  String?  @map("accent_color")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updater      User?    @relation(fields: [updatedBy], references: [id])

  @@map("solutions")
}

model Service {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  description     String?
  category        String
  serviceType     String    @default("core") @map("service_type")
  level           String    @default("intermediate")
  duration        String?
  status          String    @default("DRAFT")
  icon            String?
  backgroundImage String?   @map("background_image")
  highlight       String?
  features        Json?
  hero            Json?
  learning        Json?
  courseInfo      Json?     @map("course_info")
  about           Json?
  cta             Json?
  process         Json?
  visualElements  Json?     @map("visual_elements")
  ctaConfig       Json?     @map("cta_config")
  metrics         Json?
  seo             Json?
  displayOrder    Int?      @map("display_order")
  slug            String    @unique
  updatedBy       String?   @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  publishedAt     DateTime? @map("published_at")
  updater         User?     @relation(fields: [updatedBy], references: [id])

  @@map("services")
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  content       String?
  excerpt       String?
  featuredImage String?       @map("featured_image")
  category      String?
  tags          Json?
  status        ArticleStatus @default(DRAFT)
  authorId      String?       @map("author_id")
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  author        User?         @relation(fields: [authorId], references: [id])

  @@map("articles")
}



model MissionModule {
  id           String        @id @default(cuid())
  title        String
  subtitle     String?
  description  String?
  icon         String?
  image        String?
  highlights   Json?
  features     Json?
  achievements Json?
  gradient     String?
  accentColor  String?
  href         String?
  category     String        @unique
  status       String        @default("active")
  sortOrder    Int           @default(0)
  updatedBy    String?       @map("updated_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  items        MissionItem[]
  updater      User?         @relation(fields: [updatedBy], references: [id])

  @@map("mission_modules")
}

model MissionItem {
  id          String        @id @default(cuid())
  moduleId    String        @map("module_id")
  title       String
  description String?
  content     String?
  summary     String?
  image       String?
  date        DateTime?
  tags        Json?
  category    String?
  status      String        @default("published")
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  metadata    Json?
  authorId    String?       @map("author_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  module      MissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  author      User?         @relation(fields: [authorId], references: [id])

  @@map("mission_items")
}



model Research {
  id          String           @id @default(cuid())
  title       String
  subtitle    String?
  description String
  category    ResearchCategory
  content     String
  image       String?
  slug        String           @unique
  status      ResearchStatus   @default(DRAFT)
  publishedAt DateTime?        @map("published_at")
  tags        Json?
  authors     Json?
  attachments Json?
  featured    Boolean          @default(false)
  sortOrder   Int              @default(0) @map("sort_order")
  updatedBy   String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  updater     User?            @relation("UserResearch", fields: [updatedBy], references: [id])

  @@map("research")
}

model Avatar {
  id          String   @id @default(cuid())
  name        String
  filename    String   @unique
  url         String
  description String?
  tags        Json?
  fileSize    Int?
  mimeType    String?
  width       Int?
  height      Int?
  isActive    Boolean  @default(true)
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  uploader    User?    @relation("UserAvatars", fields: [uploadedBy], references: [id])

  @@map("avatars")
}

model ClientCase {
  id           String   @id @default(cuid())
  name         String
  logo         String?
  logoText     String?
  logoColor    String?
  industry     String
  title        String
  description  String
  image        String?
  metrics      String?
  tags         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  updater      User?    @relation("ClientCaseUpdater", fields: [updatedBy], references: [id])
  creator      User?    @relation("ClientCaseCreator", fields: [createdBy], references: [id])

  @@map("client_cases")
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  logo         String?
  logoText     String?
  website      String?
  description  String?
  category     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  updater      User?    @relation("PartnerUpdater", fields: [updatedBy], references: [id])
  creator      User?    @relation("PartnerCreator", fields: [createdBy], references: [id])

  @@map("partners")
}

model Qualification {
  id           String   @id @default(cuid())
  title        String
  description  String?
  image        String?
  category     String
  issuer       String?  // 颁发机构
  issueDate    DateTime? @map("issue_date") // 颁发日期
  expiryDate   DateTime? @map("expiry_date") // 有效期至
  certificateNumber String? @map("certificate_number") // 证书编号
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  featured     Boolean  @default(false) // 是否在首页展示
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")

  creator User? @relation("QualificationCreator", fields: [createdBy], references: [id])
  updater User? @relation("QualificationUpdater", fields: [updatedBy], references: [id])

  @@map("qualifications")
}

model Award {
  id           String    @id @default(cuid())
  title        String
  description  String?
  image        String?
  category     String
  issuer       String?   // 颁发机构
  awardDate    DateTime? @map("award_date") // 获奖日期
  year         String?   // 获奖年份
  level        String?   // 奖项级别：国家级、省级、市级等
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  featured     Boolean   @default(false) // 是否在首页展示
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  creator User? @relation("AwardCreator", fields: [createdBy], references: [id])
  updater User? @relation("AwardUpdater", fields: [updatedBy], references: [id])

  @@map("awards")
}

enum CompanyLocationType {
  HEADQUARTERS
  BRANCH
  OFFICE
  SHOWROOM
  WAREHOUSE
  FACTORY
  SERVICE_CENTER
  OTHER
}

enum ContactStatus {
  NEW
  READ
  PROCESSING
  REPLIED
  CLOSED
  SPAM
}

enum JobStatus {
  NEW
  REVIEWING
  INTERVIEW
  OFFER
  REJECTED
  HIRED
}

// 人才储备库相关枚举
enum AvailabilityStatus {
  AVAILABLE     // 可联系
  BUSY          // 忙碌中
  NOT_LOOKING   // 暂不考虑
  CONTACTED     // 已联系
  BLACKLIST     // 黑名单
}

enum InteractionType {
  EMAIL         // 邮件沟通
  PHONE         // 电话沟通
  INTERVIEW     // 面试
  NOTE          // 备注记录
  FOLLOW_UP     // 跟进记录
}

enum ProductStatus {
  AVAILABLE
  COMING_SOON
  DISCONTINUED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum ResearchCategory {
  AI_RESEARCH
  INNOVATION
  ACHIEVEMENTS
  PAPERS
}

enum ResearchStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Notification {
  id          String             @id @default(cuid())
  title       String
  message     String
  type        NotificationType   @default(INFO)
  priority    NotificationPriority @default(NORMAL)
  isRead      Boolean            @default(false) @map("is_read")
  userId      String             @map("user_id")
  actionUrl   String?            @map("action_url")
  actionText  String?            @map("action_text")
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  readAt      DateTime?          @map("read_at")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  FORM_SUBMISSION
  USER_ACTION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
