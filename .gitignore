# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# temporary development files
test-*.js
check-*.js
verify-*.js
final-*.js
add-*.js
create-*.js
fix-*.js
update-*.js
analyze-*.js
backup-*.js
restore-*.js
remove-*.js
quick-*.js

# test pages and components
/src/app/test-*
/src/app/font-debug
/src/app/font-test
/src/components/ui/font-test.tsx

# database backups
database-backup-*.json

# local database
prisma/dev.db*

# temporary report files
*_REPORT.md
*_ANALYSIS.md
*_IMPLEMENTATION.md
*_SUMMARY.md
*_GUIDE.md
*_FIX.md
*_UPDATE.md
*_REDESIGN.md
*_PLAN.md
*_STATUS.md

# temporary documentation
TEMP_*.md
temp-*.md
draft-*.md

# cleanup and utility scripts
cleanup-*.js
cleanup-*.ts
